diff --git a/packages/llm/provider-billing/src/cost-projection.ts b/packages/llm/provider-billing/src/cost-projection.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b2f8387068df0dcaa42ce595747f4c0879412215
--- /dev/null
+++ b/packages/llm/provider-billing/src/cost-projection.ts
@@ -0,0 +1,163 @@
+/**
+ * The `sessionCost` projection: a pure fold of every assistant call's usage
+ * into token and cost buckets per route and model. Mirrors token-meter's
+ * slot rule: the latest sample of one (turn, step) replaces the previous one,
+ * and `llm/retry-started` reopens the slot so the retried call adds.
+ * @module @deepseek-ai/dsh-provider-billing/cost-projection
+ */
+
+import { z } from 'zod'
+import { lastAssistantStreamChunk, type TokenUsage } from '@deepseek-ai/dsh-llm'
+import type {} from '@deepseek-ai/dsh-llm-retry/types'
+import type { SessionEvent } from '@deepseek-ai/dsh-session'
+import type { ProjectionDefinition } from '@deepseek-ai/dsh-session-projection'
+import type { SessionCostModelBuckets, SessionCostProjection } from './types.ts'
+
+const bucketsSchema = z.object({
+  inputTokens: z.number().int().nonnegative(),
+  outputTokens: z.number().int().nonnegative(),
+  cacheReadTokens: z.number().int().nonnegative(),
+  cacheWriteTokens: z.number().int().nonnegative(),
+  reportedUsd: z.number().nonnegative(),
+  uncostedSteps: z.number().int().nonnegative(),
+  steps: z.number().int().nonnegative(),
+}).strict()
+
+const modelsSchema = z.record(z.string(), z.record(z.string(), bucketsSchema))
+
+const routeSchema = z.object({ provider: z.string(), model: z.string() }).strict()
+
+const viewSchema = z.object({ models: modelsSchema }).strict()
+
+/** The unit's state schema and source of its inferred type. */
+const stateSchema = z.object({
+  models: modelsSchema,
+  /** The newest sample, replaced by a later sample of the same (turn, step). */
+  last: z.object({
+    turn: z.number().int().nonnegative(),
+    step: z.number().int().nonnegative(),
+    provider: z.string(),
+    model: z.string(),
+    buckets: bucketsSchema,
+  }).strict().nullable(),
+  /** Route of the newest request header, for attempts that committed no message. */
+  request: routeSchema.nullable(),
+}).strict()
+
+/** State of the `sessionCost` projection unit. */
+export type SessionCostState = z.infer<typeof stateSchema>
+
+declare module '@deepseek-ai/dsh-session-projection/types' {
+  interface SessionProjectionStateMap {
+    sessionCost: SessionCostState
+  }
+}
+
+const zeroBuckets = (): SessionCostModelBuckets => ({
+  inputTokens: 0,
+  outputTokens: 0,
+  cacheReadTokens: 0,
+  cacheWriteTokens: 0,
+  reportedUsd: 0,
+  uncostedSteps: 0,
+  steps: 0,
+})
+
+/** One call's usage as buckets; a call without a reported cost counts as uncosted, never as $0. */
+export function bucketsFrom(usage: TokenUsage): SessionCostModelBuckets {
+  const costed = typeof usage.cost === 'number' && Number.isFinite(usage.cost) && usage.cost >= 0
+  return {
+    inputTokens: usage.inputTokens,
+    outputTokens: usage.outputTokens,
+    cacheReadTokens: usage.cacheReadTokens ?? 0,
+    cacheWriteTokens: usage.cacheWriteTokens ?? 0,
+    reportedUsd: costed ? usage.cost as number : 0,
+    uncostedSteps: costed ? 0 : 1,
+    steps: 1,
+  }
+}
+
+const bucketsEqual = (left: SessionCostModelBuckets, right: SessionCostModelBuckets): boolean =>
+  left.inputTokens === right.inputTokens
+  && left.outputTokens === right.outputTokens
+  && left.cacheReadTokens === right.cacheReadTokens
+  && left.cacheWriteTokens === right.cacheWriteTokens
+  && left.reportedUsd === right.reportedUsd
+  && left.uncostedSteps === right.uncostedSteps
+  && left.steps === right.steps
+
+/** `a + b` or `a - b` bucket by bucket. */
+export function combineBuckets(a: SessionCostModelBuckets, b: SessionCostModelBuckets, sign: 1 | -1): SessionCostModelBuckets {
+  return {
+    inputTokens: a.inputTokens + sign * b.inputTokens,
+    outputTokens: a.outputTokens + sign * b.outputTokens,
+    cacheReadTokens: a.cacheReadTokens + sign * b.cacheReadTokens,
+    cacheWriteTokens: a.cacheWriteTokens + sign * b.cacheWriteTokens,
+    reportedUsd: Math.max(0, a.reportedUsd + sign * b.reportedUsd),
+    uncostedSteps: a.uncostedSteps + sign * b.uncostedSteps,
+    steps: a.steps + sign * b.steps,
+  }
+}
+
+function withBuckets(
+  models: SessionCostProjection['models'],
+  provider: string,
+  model: string,
+  change: (current: SessionCostModelBuckets) => SessionCostModelBuckets,
+): SessionCostProjection['models'] {
+  const current = models[provider]?.[model] ?? zeroBuckets()
+  return { ...models, [provider]: { ...models[provider], [model]: change(current) } }
+}
+
+/** The usage one durable assistant settlement reports for its attempt, if any. */
+function usageOf(event: SessionEvent): TokenUsage | undefined {
+  if (event.type === 'assistant/message' && event.data.usage !== undefined) return event.data.usage
+  if (event.type !== 'assistant/message' && event.type !== 'assistant/attempt') return undefined
+  return lastAssistantStreamChunk(event.data.stream, 'usage')?.usage
+}
+
+/** The `sessionCost` projection unit; register it on `ctx.sessionProjections`. */
+export const sessionCostProjectionDefinition = {
+  key: 'sessionCost',
+  stateVersion: 1,
+  stateSchema,
+  init: (): SessionCostState => ({ models: {}, last: null, request: null }),
+  apply: (state: SessionCostState, event: SessionEvent): SessionCostState => {
+    if (event.type === 'request/header') {
+      const { provider, model } = event.data.header.config
+      if (state.request?.provider === provider && state.request.model === model) return state
+      return { ...state, request: { provider, model } }
+    }
+    if (event.type === 'llm/retry-started') {
+      return state.last?.turn === event.data.turn && state.last.step === event.data.step
+        ? { ...state, last: null }
+        : state
+    }
+    if (event.type !== 'assistant/message' && event.type !== 'assistant/attempt') return state
+    const sample = usageOf(event)
+    if (sample === undefined) return state
+    const route = event.type === 'assistant/message'
+      ? { provider: event.data.message.source.provider, model: event.data.message.source.model }
+      : state.request
+    if (route === null) return state
+    const { turn, step } = event.data
+    const buckets = bucketsFrom(sample)
+    const previous = state.last !== null && state.last.turn === turn && state.last.step === step
+      ? state.last
+      : undefined
+    if (previous !== undefined
+      && previous.provider === route.provider
+      && previous.model === route.model
+      && bucketsEqual(previous.buckets, buckets)) return state
+    let models = state.models
+    if (previous !== undefined) {
+      models = withBuckets(models, previous.provider, previous.model, current => combineBuckets(current, previous.buckets, -1))
+    }
+    models = withBuckets(models, route.provider, route.model, current => combineBuckets(current, buckets, 1))
+    return { models, last: { turn, step, provider: route.provider, model: route.model, buckets }, request: state.request }
+  },
+  wire: {
+    viewSchema,
+    view: (state: SessionCostState): SessionCostProjection => ({ models: state.models }),
+  },
+} satisfies ProjectionDefinition<'sessionCost', SessionCostState>
