--- /dev/null
+++ b/packages/client/ui-provider-billing/src/client/index.ts
@@ -0,0 +1,58 @@
+/**
+ * Browser half: follow the Host's billing stream into one store and seat the
+ * pill before the model picker in the composer tool row.
+ */
+import type { Context } from '@deepseek-ai/cordis'
+import type {} from '@deepseek-ai/dsh-api-gateway/client'
+import type {} from '@deepseek-ai/dsh-api-remotes/client'
+import type {} from '@deepseek-ai/dsh-client-locale/client'
+import type {} from '@deepseek-ai/dsh-client-ui-conversation/client'
+import type {} from '@deepseek-ai/dsh-client-ui-model-selection/client'
+import type {} from '@deepseek-ai/dsh-client-ui-renderer/client'
+import type {} from '@deepseek-ai/dsh-client-ui-session/client'
+import { createSnapshotStore } from '@deepseek-ai/dsh-client-store'
+import type { BillingFrame } from '@deepseek-ai/dsh-provider-billing/types'
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+import { BillingPill, type BillingInjected } from './BillingPill.tsx'
+import { en, zh, type BillingKey } from './locales.ts'
+
+declare module '@deepseek-ai/dsh-client-ui-slots' {
+  interface LocaleNamespaceMap {
+    /** The composer billing pill. */
+    'provider-billing': BillingKey
+  }
+}
+
+const NS = 'provider-billing'
+
+/** Required services: slot registration, localized copy, the picker's model directories, and the Host billing stream. */
+export const inject = ['slots', 'locale', 'modelDirectories', 'remote', 'remote.providerBilling']
+
+export function apply(ctx: Context): void {
+  ctx.effect(() => ctx.locale.register(NS, { zh, en }), 'provider-billing: dictionaries')
+
+  const billing = createSnapshotStore<BillingFrame | undefined>(undefined)
+  const stream = ctx.remote.$stream<BillingFrame>({
+    name: 'provider billing',
+    open: signal => ctx.remote.providerBilling.watch(signal),
+    ended: () => new Error('provider billing stream ended'),
+  })
+  ctx.effect(() => () => stream.dispose(), 'provider-billing: stream')
+  void (async () => {
+    for await (const frame of stream) {
+      billing.set(frame.value)
+      frame.accept()
+    }
+  })().catch(() => { /* the carrier reports its own failures; the pill simply stays hidden */ })
+
+  const injected = (sessionId: SessionId): BillingInjected => ({
+    hooks: { billing, directory: ctx.modelDirectories.directoryFor(sessionId).store },
+  })
+  ctx.slots.inject('conversation.input.right', () => ctx.slots.register({
+    name: 'conversation.input.right',
+    id: 'provider-billing',
+    order: 0,
+    locale: NS,
+    inject: injected,
+  }, BillingPill))
+}
