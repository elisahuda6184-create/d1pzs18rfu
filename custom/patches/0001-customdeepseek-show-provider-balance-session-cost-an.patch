@@ -0,0 +1,504 @@
+/**
+ * Provider billing for the composer footer: the balance of every configured
+ * provider route whose endpoint has a known billing API (CloseRouter, 7api,
+ * OpenRouter), the muse subscription's usage, and the cost of every live
+ * session including its subagent sessions. Balances are polled every minute,
+ * price lists every ten minutes, and everything reaches the browser through
+ * one `providerBilling.watch` stream.
+ *
+ * Credentials are resolved per request through the credential seam and only
+ * ever placed in an outbound `authorization` header; nothing here returns or
+ * logs a key value.
+ * @module @deepseek-ai/dsh-provider-billing
+ */
+
+import { execFile } from 'node:child_process'
+import { userInfo } from 'node:os'
+import { FiberState, type Context } from '@deepseek-ai/cordis'
+import type {} from '@deepseek-ai/cordis-plugin-loader'
+import type {} from '@deepseek-ai/cordis-plugin-timer'
+import z from '@deepseek-ai/schemastery'
+import { credentialRef, isCredentialRefName } from '@deepseek-ai/dsh-credentials'
+import { launchEnvironmentOf } from '@deepseek-ai/dsh-launch-environment'
+import { attributionHeaders } from '@deepseek-ai/dsh-llm'
+import type { Session, SessionId } from '@deepseek-ai/dsh-session'
+import type {} from '@deepseek-ai/dsh-session-projection'
+import type {} from '@deepseek-ai/dsh-session-query'
+import type {} from '@deepseek-ai/dsh-subagent'
+import { Remote, TypertRemoteService } from '@deepseek-ai/dsh-typert-protocol'
+import { sessionCostProjectionDefinition } from './cost-projection.ts'
+import {
+  asRecord,
+  costOfBuckets,
+  detectKind,
+  museUsageUrl,
+  parseCloseRouterBalance,
+  parseMuseUsage,
+  parseOpenRouterCredits,
+  parseOpenRouterKeyLimit,
+  parseOpenRouterPrices,
+  parseSevenApiBalance,
+  parseSevenApiPrices,
+} from './providers.ts'
+import type {
+  BillingFrame,
+  BillingKind,
+  MuseUsage,
+  RouteBilling,
+  SessionCostProjection,
+  SessionCostView,
+  TokenPrices,
+} from './types.ts'
+
+export type * from './types.ts'
+export { sessionCostProjectionDefinition } from './cost-projection.ts'
+export * from './providers.ts'
+
+/** Plugin configuration. */
+export interface Config {
+  /** How often balances and muse usage are polled, in milliseconds. */
+  balanceRefreshMs: number
+  /** How often the 7api and OpenRouter price lists are refreshed, in milliseconds. */
+  priceRefreshMs: number
+  /** Credential reference of the OpenRouter management key that may read `/credits`. */
+  openRouterManagementKeyEnv: string
+  /** Replacement for CloseRouter's `https://api.closerouter.dev/v1/credits`, for a compatible proxy. */
+  closeRouterBalanceUrl?: string
+}
+
+export const Config: z<Config> = z.object({
+  balanceRefreshMs: z.number().min(5_000).default(60_000),
+  priceRefreshMs: z.number().min(60_000).default(10 * 60_000),
+  openRouterManagementKeyEnv: z.string().default('OPENROUTER_MANAGEMENT_KEY'),
+  closeRouterBalanceUrl: z.string(),
+})
+
+export const name = 'provider-billing'
+export const inject = ['loader', 'timer', 'sessions', 'sessionProjections']
+
+declare module '@deepseek-ai/cordis' {
+  interface Context {
+    providerBilling: ProviderBillingService
+  }
+}
+
+const LLM_PI_AI_PACKAGE = '@deepseek-ai/dsh-llm-pi-ai'
+const CLOSEROUTER_CREDITS_URL = 'https://api.closerouter.dev/v1/credits'
+const OPENROUTER_API = 'https://openrouter.ai/api/v1'
+const SEVENAPI_API = 'https://7api.st/v1'
+const REQUEST_TIMEOUT_MS = 5_000
+const MANAGEMENT_KEY_MISS_TTL_MS = 10 * 60_000
+const RECOMPUTE_DEBOUNCE_MS = 250
+
+/** One llm-pi-ai route with a recognized billing API. */
+interface RouteProfile {
+  route: string
+  displayName: string
+  kind: BillingKind
+  apiKeyEnv?: string
+  baseURL?: string
+}
+
+/** Read the login Keychain entry `service` for the current user (macOS only); absent on any failure. */
+function readKeychain(service: string): Promise<string | undefined> {
+  return new Promise((resolve) => {
+    execFile(
+      '/usr/bin/security',
+      ['find-generic-password', '-a', userInfo().username, '-s', service, '-w'],
+      { timeout: 3_000 },
+      (error, stdout) => {
+        const key = error === null ? String(stdout).trim() : ''
+        resolve(key === '' ? undefined : key)
+      },
+    )
+  })
+}
+
+/** Host Remote and poller behind the composer's billing pill. */
+export class ProviderBillingService extends TypertRemoteService {
+  static inject = ['loader', 'timer', 'sessions', 'sessionProjections']
+
+  private readonly lifetime = new AbortController()
+  private readonly listeners = new Set<() => void>()
+  private routes = new Map<string, RouteBilling>()
+  private readonly prices = new Map<BillingKind, Map<string, TokenPrices>>()
+  private sessionCosts: Record<string, SessionCostView> = {}
+  private frame: BillingFrame = { routes: {}, sessionCosts: {}, at: 0 }
+  private readonly coldViews = new Map<SessionId, SessionCostProjection | null>()
+  private recomputeTimer: ReturnType<typeof setTimeout> | undefined
+  private recomputing = false
+  private recomputeAgain = false
+  private managementKey: string | undefined
+  private managementKeyMissAt = 0
+
+  /**
+   * @param ctx - Host context carrying the loader, timer, session store and projection registry.
+   * @param config - poll periods and credential references.
+   */
+  constructor(ctx: Context, private readonly config: Config) {
+    super(ctx, 'providerBilling')
+    ctx.effect(() => ctx.sessionProjections.register(sessionCostProjectionDefinition), 'provider-billing: sessionCost projection')
+    ctx.effect(() => ctx.sessionProjections.onChanged((_session, key) => {
+      if (key === 'sessionCost') this.scheduleRecompute()
+    }), 'provider-billing: cost changes')
+    ctx.effect(() => ctx.on('session/event', (_session, event) => {
+      if (event.type === 'request/header' || event.type === 'subagent/catalog') this.scheduleRecompute()
+    }), 'provider-billing: session activity')
+    ctx.effect(() => () => {
+      this.lifetime.abort()
+      if (this.recomputeTimer !== undefined) clearTimeout(this.recomputeTimer)
+      for (const listener of this.listeners) listener()
+    }, 'provider-billing: lifetime')
+    ctx.interval(() => { void this.refreshBalances() }, config.balanceRefreshMs)
+    ctx.interval(() => { void this.refreshPrices() }, config.priceRefreshMs)
+    void this.refreshPrices().then(() => this.refreshBalances())
+    this.scheduleRecompute()
+  }
+
+  /** The current frame: routes, session costs, and when it was computed. */
+  @Remote
+  snapshot(): Promise<BillingFrame> {
+    return Promise.resolve(this.frame)
+  }
+
+  /**
+   * The current frame now and again after every change.
+   * @param signal - the carrier's cancellation.
+   */
+  @Remote({ mode: 'stream' })
+  async *watch(signal: AbortSignal): AsyncIterable<BillingFrame> {
+    let update = Promise.withResolvers<void>()
+    const changed = (): void => { update.resolve() }
+    this.listeners.add(changed)
+    signal.addEventListener('abort', changed, { once: true })
+    this.scheduleRecompute()
+    try {
+      while (!signal.aborted && !this.lifetime.signal.aborted) {
+        yield this.frame
+        await update.promise
+        update = Promise.withResolvers<void>()
+      }
+    } finally {
+      this.listeners.delete(changed)
+      signal.removeEventListener('abort', changed)
+    }
+  }
+
+  /** Recompute every live session's cost soon, coalescing bursts of changes. */
+  private scheduleRecompute(): void {
+    if (this.lifetime.signal.aborted || this.recomputeTimer !== undefined) return
+    const timer = setTimeout(() => {
+      this.recomputeTimer = undefined
+      void this.recompute()
+    }, RECOMPUTE_DEBOUNCE_MS)
+    timer.unref?.()
+    this.recomputeTimer = timer
+  }
+
+  private publish(): void {
+    const routes: Record<string, RouteBilling> = {}
+    for (const [route, billing] of this.routes) routes[route] = billing
+    this.frame = { routes, sessionCosts: this.sessionCosts, at: Date.now() }
+    for (const listener of this.listeners) listener()
+  }
+
+  // ── routes and credentials ───────────────────────────────────────────────
+
+  /** Every llm-pi-ai route whose endpoint host or credential name names a billing API. */
+  private routeProfiles(): RouteProfile[] {
+    const profiles: RouteProfile[] = []
+    for (const entry of this.ctx.loader.entries()) {
+      if (entry.options.name !== LLM_PI_AI_PACKAGE) continue
+      const fiber = entry.fiber
+      if (fiber === undefined || fiber.state !== FiberState.ACTIVE) continue
+      const providers: unknown = asRecord(fiber.config)?.providers
+      const volatile = asRecord(providers)
+      const snapshot = typeof volatile?.get === 'function' ? (volatile.get as () => unknown)() : providers
+      const dict = asRecord(snapshot)
+      if (dict === undefined) continue
+      for (const [route, raw] of Object.entries(dict)) {
+        const profile = asRecord(raw)
+        if (profile === undefined) continue
+        const apiKeyEnv = typeof profile.apiKeyEnv === 'string' ? profile.apiKeyEnv : undefined
+        const baseURL = typeof profile.baseURL === 'string' ? profile.baseURL : undefined
+        const kind = detectKind(baseURL, apiKeyEnv)
+        if (kind === undefined) continue
+        const displayName = typeof profile.displayName === 'string' && profile.displayName !== '' ? profile.displayName : route
+        profiles.push({
+          route,
+          displayName,
+          kind,
+          ...apiKeyEnv === undefined ? {} : { apiKeyEnv },
+          ...baseURL === undefined ? {} : { baseURL },
+        })
+      }
+    }
+    return profiles
+  }
+
+  /** The secret a credential reference resolves to, through the seam (else the launch environment); never logged. */
+  private async resolveSecret(ref: string | undefined): Promise<string | undefined> {
+    if (ref === undefined || !isCredentialRefName(ref)) return undefined
+    const branded = credentialRef(ref)
+    const credentials = this.ctx.get('credentials')
+    const value = credentials !== undefined
+      ? (await credentials.resolve(branded))?.value
+      : launchEnvironmentOf(this.ctx).get(branded)?.value
+    return value !== undefined && value.trim() !== '' ? value.trim() : undefined
+  }
+
+  /** The OpenRouter management key: the credential seam first, then the macOS login Keychain. */
+  private async managementKeyValue(): Promise<string | undefined> {
+    const direct = await this.resolveSecret(this.config.openRouterManagementKeyEnv)
+    if (direct !== undefined) return direct
+    if (process.platform !== 'darwin') return undefined
+    if (this.managementKey !== undefined) return this.managementKey
+    if (Date.now() - this.managementKeyMissAt < MANAGEMENT_KEY_MISS_TTL_MS) return undefined
+    const key = await readKeychain(this.config.openRouterManagementKeyEnv)
+    if (key === undefined) {
+      this.managementKeyMissAt = Date.now()
+      return undefined
+    }
+    this.managementKey = key
+    return key
+  }
+
+  // ── HTTP ─────────────────────────────────────────────────────────────────
+
+  /** Authenticated JSON GET; absent on any failure (never thrown, never logged with the key). */
+  private async getJson(url: string, key: string): Promise<unknown> {
+    if (this.lifetime.signal.aborted) return undefined
+    try {
+      const headers = new Headers({ accept: 'application/json', authorization: `Bearer ${key}` })
+      for (const [name, value] of Object.entries(attributionHeaders())) headers.set(name, value)
+      const response = await fetch(url, {
+        method: 'GET',
+        headers,
+        redirect: 'error',
+        signal: AbortSignal.any([this.lifetime.signal, AbortSignal.timeout(REQUEST_TIMEOUT_MS)]),
+      })
+      if (!response.ok) {
+        this.ctx.logger.debug('provider-billing: %s answered HTTP %d', url, response.status)
+        return undefined
+      }
+      return await response.json()
+    } catch (error) {
+      if (!this.lifetime.signal.aborted) {
+        this.ctx.logger.debug('provider-billing: %s unreachable: %s', url, error instanceof Error ? error.message : String(error))
+      }
+      return undefined
+    }
+  }
+
+  private async fetchBalance(profile: RouteProfile, key: string): Promise<number | undefined> {
+    switch (profile.kind) {
+      case 'closerouter':
+        return parseCloseRouterBalance(await this.getJson(this.config.closeRouterBalanceUrl ?? CLOSEROUTER_CREDITS_URL, key))
+      case 'sevenapi':
+        return parseSevenApiBalance(await this.getJson(`${SEVENAPI_API}/balance`, key))
+      case 'openrouter': {
+        const managementKey = await this.managementKeyValue()
+        if (managementKey !== undefined) {
+          const credits = parseOpenRouterCredits(await this.getJson(`${OPENROUTER_API}/credits`, managementKey))
+          if (credits !== undefined) return credits
+        }
+        // A key without a credit limit reports null: the balance is then unknown, not $0.
+        return parseOpenRouterKeyLimit(await this.getJson(`${OPENROUTER_API}/key`, key))
+      }
+      case 'muse':
+        return undefined
+    }
+  }
+
+  private async fetchMuse(profile: RouteProfile, key: string): Promise<MuseUsage | undefined> {
+    if (profile.baseURL === undefined) return undefined
+    let url: string
+    try {
+      url = museUsageUrl(profile.baseURL)
+    } catch {
+      return undefined
+    }
+    return parseMuseUsage(await this.getJson(url, key))
+  }
+
+  /** Poll every recognized route whose credential resolves; a failed poll hides the figure rather than keeping a stale one. */
+  private async refreshBalances(): Promise<void> {
+    const profiles = this.routeProfiles()
+    const next = new Map<string, RouteBilling>()
+    await Promise.all(profiles.map(async (profile) => {
+      const key = await this.resolveSecret(profile.apiKeyEnv)
+      const row: RouteBilling = {
+        route: profile.route,
+        displayName: profile.displayName,
+        kind: profile.kind,
+        configured: key !== undefined,
+      }
+      if (key !== undefined) {
+        if (profile.kind === 'muse') {
+          const usage = await this.fetchMuse(profile, key)
+          if (usage !== undefined) {
+            row.muse = usage
+            row.checkedAt = Date.now()
+          }
+        } else {
+          const usd = await this.fetchBalance(profile, key)
+          if (usd !== undefined) {
+            row.balanceUsd = usd
+            row.checkedAt = Date.now()
+          }
+        }
+      }
+      next.set(profile.route, row)
+    }))
+    if (this.lifetime.signal.aborted) return
+    this.routes = next
+    this.publish()
+    this.scheduleRecompute()
+  }
+
+  /** Refresh the 7api and OpenRouter price lists; a failed fetch keeps the previous list. */
+  private async refreshPrices(): Promise<void> {
+    const profiles = this.routeProfiles()
+    const byKind = new Map<BillingKind, RouteProfile>()
+    for (const profile of profiles) if (!byKind.has(profile.kind)) byKind.set(profile.kind, profile)
+    const sevenapi = byKind.get('sevenapi')
+    if (sevenapi !== undefined) {
+      const key = await this.resolveSecret(sevenapi.apiKeyEnv)
+      if (key !== undefined) {
+        const prices = parseSevenApiPrices(await this.getJson(`${SEVENAPI_API}/models`, key))
+        if (prices.size > 0) this.prices.set('sevenapi', prices)
+      }
+    }
+    const openrouter = byKind.get('openrouter')
+    if (openrouter !== undefined) {
+      const key = await this.resolveSecret(openrouter.apiKeyEnv)
+      if (key !== undefined) {
+        const prices = parseOpenRouterPrices(await this.getJson(`${OPENROUTER_API}/models`, key))
+        if (prices.size > 0) this.prices.set('openrouter', prices)
+      }
+    }
+    if (!this.lifetime.signal.aborted) this.scheduleRecompute()
+  }
+
+  // ── session cost ─────────────────────────────────────────────────────────
+
+  /**
+   * Price one session's buckets. A model whose every call reported a cost
+   * sums those costs; a model with any uncosted call is priced from its
+   * provider's price list as a whole, and without a price the figure is
+   * incomplete and therefore hidden, never partial.
+   */
+  private price(view: SessionCostProjection): { usd: number; complete: boolean; steps: number } {
+    let usd = 0
+    let complete = true
+    let steps = 0
+    for (const [route, models] of Object.entries(view.models)) {
+      for (const [model, buckets] of Object.entries(models)) {
+        steps += buckets.steps
+        if (buckets.steps === 0) continue
+        if (buckets.uncostedSteps === 0) {
+          usd += buckets.reportedUsd
+          continue
+        }
+        const kind = this.routes.get(route)?.kind ?? this.routeProfiles().find(profile => profile.route === route)?.kind
+        const table = kind === undefined ? undefined : this.prices.get(kind)
+        const prices = table?.get(model)
+        if (prices === undefined) {
+          complete = false
+          continue
+        }
+        usd += costOfBuckets(buckets, prices)
+      }
+    }
+    return { usd, complete, steps }
+  }
+
+  private liveView(session: Session): SessionCostProjection | undefined {
+    return this.ctx.sessionProjections.snapshot(session, ['sessionCost']).values.sessionCost
+  }
+
+  /** A session's `sessionCost` view: live when attached, else the persisted projection (cached, since a cold log does not change). */
+  private async viewOf(id: SessionId): Promise<SessionCostProjection | undefined> {
+    const live = this.ctx.sessions.get(id)
+    if (live !== undefined) return this.liveView(live)
+    const cached = this.coldViews.get(id)
+    if (cached !== undefined) return cached ?? undefined
+    const query = this.ctx.get('sessionQuery')
+    if (query === undefined) return undefined
+    try {
+      using observation = await query.observeSession(id, { signal: this.lifetime.signal })
+      const view = observation.projections?.values.sessionCost
+      this.coldViews.set(id, view ?? null)
+      return view
+    } catch {
+      return undefined
+    }
+  }
+
+  /** One session's cost: its own buckets plus every catalog descendant's. */
+  private async costOf(session: Session): Promise<SessionCostView> {
+    const views: SessionCostProjection[] = []
+    const own = this.liveView(session)
+    if (own !== undefined) views.push(own)
+    const subagents = this.ctx.get('subagents')
+    if (subagents !== undefined) {
+      try {
+        for (const entry of await subagents.listDescendants(session.id, this.lifetime.signal)) {
+          if (entry.kind !== 'child') continue
+          const view = await this.viewOf(entry.id)
+          if (view !== undefined) views.push(view)
+        }
+      } catch {
+        // No catalog or query service: the session's own cost still counts.
+      }
+    }
+    let usd = 0
+    let complete = true
+    let steps = 0
+    for (const view of views) {
+      const priced = this.price(view)
+      usd += priced.usd
+      steps += priced.steps
+      if (!priced.complete) complete = false
+    }
+    return { usd, complete, steps, sessions: views.length }
+  }
+
+  private async recompute(): Promise<void> {
+    if (this.recomputing) {
+      this.recomputeAgain = true
+      return
+    }
+    this.recomputing = true
+    try {
+      const next: Record<string, SessionCostView> = {}
+      for (const session of this.ctx.sessions.list()) {
+        if (this.lifetime.signal.aborted) return
+        next[session.id] = await this.costOf(session)
+      }
+      if (JSON.stringify(next) !== JSON.stringify(this.sessionCosts)) {
+        this.sessionCosts = next
+        this.publish()
+      }
+    } catch (error) {
+      if (!this.lifetime.signal.aborted) {
+        this.ctx.logger.debug('provider-billing: session cost recompute failed: %s', error instanceof Error ? error.message : String(error))
+      }
+    } finally {
+      this.recomputing = false
+      if (this.recomputeAgain) {
+        this.recomputeAgain = false
+        this.scheduleRecompute()
+      }
+    }
+  }
+}
+
+/**
+ * Mount the `providerBilling` Remote and its poller.
+ * @param ctx - Host context.
+ * @param config - validated plugin configuration.
+ */
+export function apply(ctx: Context, config: Config): void {
+  ctx.plugin(ProviderBillingService, config)
+}
