+/**
+ * Pure helpers: which billing API a route speaks, how each reply is read, and
+ * how token buckets are priced. No I/O here, so every rule is unit-testable.
+ * @module @deepseek-ai/dsh-provider-billing/providers
+ */
+
+import type { BillingKind, MuseQuota, MuseUsage, SessionCostModelBuckets, TokenPrices } from './types.ts'
+
+/** The credential reference that marks a muse forwarder route. */
+export const MUSE_API_KEY_ENV = 'MUSE_FORWARDER_KEY'
+
+const CLOSEROUTER_BALANCE_KEYS = ['total_credits', 'balance', 'remaining', 'remaining_usd', 'credits'] as const
+
+/** Plain objects only. */
+export function asRecord(value: unknown): Record<string, unknown> | undefined {
+  return typeof value === 'object' && value !== null && !Array.isArray(value)
+    ? value as Record<string, unknown>
+    : undefined
+}
+
+/** JSON numbers and numeric strings; anything else is absent. */
+export function toFiniteNumber(value: unknown): number | undefined {
+  if (typeof value === 'number') return Number.isFinite(value) ? value : undefined
+  if (typeof value === 'string' && value.trim() !== '') {
+    const parsed = Number(value)
+    return Number.isFinite(parsed) ? parsed : undefined
+  }
+  return undefined
+}
+
+/**
+ * Recognize the billing API behind a route from its endpoint host, or the
+ * muse forwarder from its credential name (its host is deployment-specific).
+ * @param baseURL - the route's `baseURL`, when configured.
+ * @param apiKeyEnv - the route's `apiKeyEnv`, when configured.
+ * @returns the billing kind, or absent for a route with no known billing API.
+ */
+export function detectKind(baseURL: string | undefined, apiKeyEnv: string | undefined): BillingKind | undefined {
+  if (apiKeyEnv === MUSE_API_KEY_ENV) return 'muse'
+  if (baseURL === undefined) return undefined
+  let host: string
+  try {
+    host = new URL(baseURL).host
+  } catch {
+    return undefined
+  }
+  if (host === 'api.closerouter.dev') return 'closerouter'
+  if (host === 'openrouter.ai') return 'openrouter'
+  if (host === '7api.st') return 'sevenapi'
+  return undefined
+}
+
+/**
+ * CloseRouter `GET /v1/credits`: the first finite value among the known
+ * balance keys, descending into `data`. `total_credits` is the available
+ * balance; `total_usage` is lifetime spend and is ignored.
+ */
+export function parseCloseRouterBalance(body: unknown): number | undefined {
+  const record = asRecord(body)
+  if (record === undefined) return toFiniteNumber(body)
+  for (const key of CLOSEROUTER_BALANCE_KEYS) {
+    const balance = toFiniteNumber(record[key])
+    if (balance !== undefined) return balance
+  }
+  return 'data' in record ? parseCloseRouterBalance(record.data) : undefined
+}
+
+/** OpenRouter `GET /api/v1/credits` (management key): `total_credits - total_usage`, both required. */
+export function parseOpenRouterCredits(body: unknown): number | undefined {
+  const data = asRecord(asRecord(body)?.data)
+  const total = toFiniteNumber(data?.total_credits)
+  const usage = toFiniteNumber(data?.total_usage)
+  return total === undefined || usage === undefined ? undefined : total - usage
+}
+
+/** OpenRouter `GET /api/v1/key` (API key): `data.limit_remaining`; `null` (no credit limit) means unknown. */
+export function parseOpenRouterKeyLimit(body: unknown): number | undefined {
+  return toFiniteNumber(asRecord(asRecord(body)?.data)?.limit_remaining)
+}
+
+/** 7api `GET /v1/balance`: `balance_usd`. */
+export function parseSevenApiBalance(body: unknown): number | undefined {
+  return toFiniteNumber(asRecord(body)?.balance_usd)
+}
+
+/** 7api `GET /v1/models`: one price per million for every token kind, the cache read its own. */
+export function parseSevenApiPrices(body: unknown): Map<string, TokenPrices> {
+  const prices = new Map<string, TokenPrices>()
+  const data = asRecord(body)?.data
+  if (!Array.isArray(data)) return prices
+  for (const entry of data) {
+    const row = asRecord(entry)
+    const pricing = asRecord(row?.pricing)
+    const id = row?.id
+    const price = toFiniteNumber(pricing?.price_usd_per_mtok)
+    const cacheRead = toFiniteNumber(pricing?.cache_read_usd_per_mtok)
+    if (typeof id !== 'string' || price === undefined || cacheRead === undefined) continue
+    prices.set(id, { input: price, output: price, cacheWrite: price, cacheRead })
+  }
+  return prices
+}
+
+/** OpenRouter `GET /api/v1/models`: per-token USD strings become per-million prices; `-1` (variable) entries are skipped. */
+export function parseOpenRouterPrices(body: unknown): Map<string, TokenPrices> {
+  const prices = new Map<string, TokenPrices>()
+  const data = asRecord(body)?.data
+  if (!Array.isArray(data)) return prices
+  const perMillion = (value: unknown): number | undefined => {
+    const perToken = toFiniteNumber(value)
+    return perToken === undefined || perToken < 0 ? undefined : perToken * 1_000_000
+  }
+  for (const entry of data) {
+    const row = asRecord(entry)
+    const pricing = asRecord(row?.pricing)
+    const id = row?.id
+    const input = perMillion(pricing?.prompt)
+    const output = perMillion(pricing?.completion)
+    if (typeof id !== 'string' || input === undefined || output === undefined) continue
+    prices.set(id, {
+      input,
+      output,
+      cacheRead: perMillion(pricing?.input_cache_read) ?? input,
+      cacheWrite: perMillion(pricing?.input_cache_write) ?? input,
+    })
+  }
+  return prices
+}
+
+/** Price every token of the buckets, as an estimate for calls that reported no cost. */
+export function costOfBuckets(buckets: SessionCostModelBuckets, prices: TokenPrices): number {
+  return (
+    buckets.inputTokens * prices.input
+    + buckets.outputTokens * prices.output
+    + buckets.cacheReadTokens * prices.cacheRead
+    + buckets.cacheWriteTokens * prices.cacheWrite
+  ) / 1_000_000
+}
+
+/** `/usage` lives at the root of the forwarder host, not under `/v1`. */
+export function museUsageUrl(baseURL: string): string {
+  return `${new URL(baseURL).origin}/usage`
+}
+
+/** `5h window`, `45m window`, `1h 30m window`; `Window` when the duration is unknown. */
+export function windowLabel(minutes: number | undefined): string {
+  const whole = minutes === undefined || !Number.isFinite(minutes) ? 0 : Math.round(minutes)
+  if (whole <= 0) return 'Window'
+  const hours = Math.floor(whole / 60)
+  const rest = whole % 60
+  if (hours === 0) return `${String(rest)}m window`
+  return rest === 0 ? `${String(hours)}h window` : `${String(hours)}h ${String(rest)}m window`
+}
+
+function isoFromUnixSeconds(value: unknown): string | undefined {
+  const seconds = toFiniteNumber(value)
+  if (seconds === undefined) return undefined
+  const date = new Date(seconds * 1000)
+  return Number.isNaN(date.getTime()) ? undefined : date.toISOString()
+}
+
+function parseQuota(value: unknown): MuseQuota | undefined {
+  const quota = asRecord(value)
+  const percent = toFiniteNumber(quota?.used_percent)
+  if (percent === undefined) return undefined
+  const resetAt = isoFromUnixSeconds(quota?.resets_at)
+  return {
+    usedRatio: Math.max(0, Math.min(percent / 100, 1)),
+    ...resetAt === undefined ? {} : { resetAt },
+  }
+}
+
+function nonNegative(value: unknown): number {
+  const number = toFiniteNumber(value)
+  return number === undefined || number < 0 ? 0 : number
+}
+
+/** The forwarder's `GET /usage` reply; absent unless both quota windows report a used percentage. */
+export function parseMuseUsage(body: unknown): MuseUsage | undefined {
+  const record = asRecord(body)
+  const subscription = asRecord(record?.subscription)
+  const weekly = parseQuota(subscription?.weekly)
+  const windowRecord = asRecord(subscription?.window)
+  const window = parseQuota(windowRecord)
+  if (weekly === undefined || window === undefined) return undefined
+  const identity = asRecord(record?.identity)
+  const version = identity?.muse_version
+  const tokens = asRecord(record?.tokens)
+  const requests = toFiniteNumber(record?.requests)
+  return {
+    weekly,
+    window,
+    windowLabel: windowLabel(toFiniteNumber(windowRecord?.window_duration_mins)),
+    ...typeof version === 'string' && version !== '' ? { version } : {},
+    tokens: {
+      input: nonNegative(tokens?.input),
+      output: nonNegative(tokens?.output),
+      cached: nonNegative(tokens?.cached),
+      reasoning: nonNegative(tokens?.reasoning),
+    },
+    ...requests === undefined ? {} : { requests },
+  }
+}
diff --git a/packages/llm/provider-billing/src/types.ts b/packages/llm/provider-billing/src/types.ts
new file mode 100644
index 0000000000000000000000000000000000000000..b0be6229ef41aa154e7fc6ae110f8dc89fc25f05
--- /dev/null
+++ b/packages/llm/provider-billing/src/types.ts
@@ -0,0 +1,100 @@
+/**
+ * Wire and projection types of the provider-billing plugin. Client-safe:
+ * no runtime imports.
+ * @module @deepseek-ai/dsh-provider-billing/types
+ */
+
+/** Which billing API a provider route speaks, recognized from its endpoint host or credential name. */
+export type BillingKind = 'closerouter' | 'openrouter' | 'sevenapi' | 'muse'
+
+/** One quota window of the muse subscription. */
+export interface MuseQuota {
+  /** Fraction used, clamped to 0..1. */
+  usedRatio: number
+  /** ISO time the window resets, when the forwarder reported one. */
+  resetAt?: string
+}
+
+/** The muse forwarder's `GET /usage` reply, normalized. */
+export interface MuseUsage {
+  weekly: MuseQuota
+  window: MuseQuota
+  /** Human label of the short window, e.g. `5h window`. */
+  windowLabel: string
+  version?: string
+  tokens: { input: number; output: number; cached: number; reasoning: number }
+  requests?: number
+}
+
+/** Billing facts for one configured provider route. */
+export interface RouteBilling {
+  /** The llm-pi-ai route key. */
+  route: string
+  /** Name shown next to the figures. */
+  displayName: string
+  kind: BillingKind
+  /** Whether the route's credential resolved; nothing is polled without it. */
+  configured: boolean
+  /** Account balance in USD; absent while unknown or after a failed poll. */
+  balanceUsd?: number
+  /** Subscription usage for a `muse` route; absent while unknown or after a failed poll. */
+  muse?: MuseUsage
+  /** Epoch milliseconds of the last successful read. */
+  checkedAt?: number
+}
+
+/** Cost of one session including every subagent session under it. */
+export interface SessionCostView {
+  /** USD summed over every priced call. */
+  usd: number
+  /** Whether every billed call could be priced; the figure is hidden otherwise. */
+  complete: boolean
+  /** Calls that reported usage across the summed sessions. */
+  steps: number
+  /** Sessions summed: the session itself plus its descendants. */
+  sessions: number
+}
+
+/** One frame of the `providerBilling.watch` stream. */
+export interface BillingFrame {
+  /** Every llm-pi-ai route whose endpoint has a known billing API, keyed by route. */
+  routes: Record<string, RouteBilling>
+  /** Cost per live session id. */
+  sessionCosts: Record<string, SessionCostView>
+  /** Epoch milliseconds the frame was computed. */
+  at: number
+}
+
+/** Token and cost buckets of one provider/model pair within one session. */
+export interface SessionCostModelBuckets {
+  inputTokens: number
+  outputTokens: number
+  cacheReadTokens: number
+  cacheWriteTokens: number
+  /** Sum of the gateway-reported costs of the calls that carried one. */
+  reportedUsd: number
+  /** Calls whose usage carried no cost. */
+  uncostedSteps: number
+  /** Calls that reported usage. */
+  steps: number
+}
+
+/** Client view of the `sessionCost` projection: buckets by route, then by model id. */
+export interface SessionCostProjection {
+  models: Record<string, Record<string, SessionCostModelBuckets>>
+}
+
+/** USD per million tokens for one model. */
+export interface TokenPrices {
+  input: number
+  output: number
+  cacheRead: number
+  cacheWrite: number
+}
+
+declare module '@deepseek-ai/dsh-session-projection/types' {
+  interface SessionProjectionMap {
+    /** Provider-reported cost and token buckets per route and model across the durable log. */
+    sessionCost: SessionCostProjection
+  }
+}
diff --git a/packages/llm/provider-billing/tests/cost-projection.spec.ts b/packages/llm/provider-billing/tests/cost-projection.spec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..5d79f6654d3d739a3bc0507f3fffd27578a64325
--- /dev/null
+++ b/packages/llm/provider-billing/tests/cost-projection.spec.ts
@@ -0,0 +1,94 @@
+import { describe, expect, it } from 'vitest'
+import type { SessionEvent } from '@deepseek-ai/dsh-session'
+import { bucketsFrom, sessionCostProjectionDefinition as unit } from '../src/cost-projection.ts'
+
+const header = (provider: string, model: string): SessionEvent => ({
+  type: 'request/header',
+  seq: 1,
+  time: 1,
+  data: { header: { config: { provider, model } }, reason: 'start' },
+} as unknown as SessionEvent)
+
+const message = (turn: number, step: number, provider: string, model: string, usage: Record<string, number>): SessionEvent => ({
+  type: 'assistant/message',
+  seq: 2,
+  time: 2,
+  data: {
+    turn,
+    step,
+    message: { id: 'm', role: 'assistant', content: [], source: { kind: 'model', provider, model } },
+    stream: [],
+    usage: { inputTokens: 0, outputTokens: 0, ...usage },
+  },
+} as unknown as SessionEvent)
+
+const attempt = (turn: number, step: number, usage: Record<string, number>): SessionEvent => ({
+  type: 'assistant/attempt',
+  seq: 3,
+  time: 3,
+  data: {
+    turn,
+    step,
+    stream: [{ type: 'chunk', time: 3, chunk: { type: 'usage', usage: { inputTokens: 0, outputTokens: 0, ...usage } } }],
+  },
+} as unknown as SessionEvent)
+
+const retryStarted = (turn: number, step: number): SessionEvent => ({
+  type: 'llm/retry-started',
+  seq: 4,
+  time: 4,
+  data: { turn, step },
+} as unknown as SessionEvent)
+
+describe('bucketsFrom', () => {
+  it('counts a call without a reported cost as uncosted, never as $0', () => {
+    expect(bucketsFrom({ inputTokens: 10, outputTokens: 5 })).toEqual({
+      inputTokens: 10, outputTokens: 5, cacheReadTokens: 0, cacheWriteTokens: 0, reportedUsd: 0, uncostedSteps: 1, steps: 1,
+    })
+    expect(bucketsFrom({ inputTokens: 10, outputTokens: 5, cacheReadTokens: 3, cost: 0.002 })).toEqual({
+      inputTokens: 10, outputTokens: 5, cacheReadTokens: 3, cacheWriteTokens: 0, reportedUsd: 0.002, uncostedSteps: 0, steps: 1,
+    })
+  })
+})
+
+describe('sessionCost projection', () => {
+  it('sums calls per route and model and keeps the request header route for attempts', () => {
+    let state = unit.init()
+    state = unit.apply(state, header('closerouter', 'openai/gpt-6-astra'))
+    state = unit.apply(state, message(1, 1, 'closerouter', 'openai/gpt-6-astra', { inputTokens: 100, outputTokens: 10, cost: 0.001 }))
+    state = unit.apply(state, attempt(1, 2, { inputTokens: 50, outputTokens: 5 }))
+    state = unit.apply(state, message(2, 1, 'sevenapi', 'gpt-5.5', { inputTokens: 20, outputTokens: 2 }))
+    const view = unit.wire.view(state)
+    expect(view.models.closerouter?.['openai/gpt-6-astra']).toEqual({
+      inputTokens: 150, outputTokens: 15, cacheReadTokens: 0, cacheWriteTokens: 0, reportedUsd: 0.001, uncostedSteps: 1, steps: 2,
+    })
+    expect(view.models.sevenapi?.['gpt-5.5']?.uncostedSteps).toBe(1)
+  })
+
+  it('replaces the sample of the same turn and step instead of adding it twice', () => {
+    let state = unit.init()
+    state = unit.apply(state, message(1, 1, 'closerouter', 'm', { inputTokens: 100, outputTokens: 10, cost: 0.001 }))
+    state = unit.apply(state, message(1, 1, 'closerouter', 'm', { inputTokens: 120, outputTokens: 12, cost: 0.0012 }))
+    expect(unit.wire.view(state).models.closerouter?.m).toEqual({
+      inputTokens: 120, outputTokens: 12, cacheReadTokens: 0, cacheWriteTokens: 0, reportedUsd: 0.0012, uncostedSteps: 0, steps: 1,
+    })
+  })
+
+  it('adds a retried attempt after llm/retry-started reopens the slot', () => {
+    let state = unit.init()
+    state = unit.apply(state, header('closerouter', 'm'))
+    state = unit.apply(state, attempt(1, 1, { inputTokens: 100, outputTokens: 0 }))
+    state = unit.apply(state, retryStarted(1, 1))
+    state = unit.apply(state, message(1, 1, 'closerouter', 'm', { inputTokens: 100, outputTokens: 10, cost: 0.001 }))
+    expect(unit.wire.view(state).models.closerouter?.m?.steps).toBe(2)
+    expect(unit.wire.view(state).models.closerouter?.m?.inputTokens).toBe(200)
+  })
+
+  it('returns the same state for unrelated events and validates its own state', () => {
+    const state = unit.init()
+    const next = unit.apply(state, { type: 'turn/start', seq: 0, time: 0, data: { turn: 1 } } as unknown as SessionEvent)
+    expect(next).toBe(state)
+    expect(unit.stateSchema.parse(state)).toEqual(state)
+    expect(unit.wire.viewSchema.parse(unit.wire.view(state))).toEqual({ models: {} })
+  })
+})
diff --git a/packages/llm/provider-billing/tests/providers.spec.ts b/packages/llm/provider-billing/tests/providers.spec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1b635f99301881445420a15fbeccd2653e1c2fc5
--- /dev/null
+++ b/packages/llm/provider-billing/tests/providers.spec.ts
@@ -0,0 +1,147 @@
+import { describe, expect, it } from 'vitest'
+import {
+  costOfBuckets,
+  detectKind,
+  museUsageUrl,
+  parseCloseRouterBalance,
+  parseMuseUsage,
+  parseOpenRouterCredits,
+  parseOpenRouterKeyLimit,
+  parseOpenRouterPrices,
+  parseSevenApiBalance,
+  parseSevenApiPrices,
+  toFiniteNumber,
+  windowLabel,
+} from '../src/providers.ts'
+
+describe('detectKind', () => {
+  it('recognizes the billing API from the endpoint host', () => {
+    expect(detectKind('https://api.closerouter.dev/v1', 'CLOSEROUTER_API_KEY')).toBe('closerouter')
+    expect(detectKind('https://api.closerouter.dev', 'CLOSEROUTER_API_KEY')).toBe('closerouter')
+    expect(detectKind('https://7api.st/v1', 'SEVENAPI_API_KEY')).toBe('sevenapi')
+    expect(detectKind('https://7api.st', 'SEVENAPI_API_KEY')).toBe('sevenapi')
+    expect(detectKind('https://openrouter.ai/api/v1', 'OPENROUTER_API_KEY')).toBe('openrouter')
+  })
+
+  it('recognizes the muse forwarder by its credential name, whatever its host', () => {
+    expect(detectKind('https://relay.example:8788/v1', 'MUSE_FORWARDER_KEY')).toBe('muse')
+  })
+
+  it('knows no billing API for other hosts or unparseable endpoints', () => {
+    expect(detectKind('https://api.deepseek.com/anthropic', 'DEEPSEEK_API_KEY')).toBeUndefined()
+    expect(detectKind('not a url', 'X')).toBeUndefined()
+    expect(detectKind(undefined, undefined)).toBeUndefined()
+  })
+})
+
+describe('balance parsers', () => {
+  it('reads CloseRouter total_credits, ignoring total_usage, with or without a data envelope', () => {
+    expect(parseCloseRouterBalance({ data: { total_credits: 107.3, total_usage: 779.9 } })).toBe(107.3)
+    expect(parseCloseRouterBalance({ total_credits: '12.5' })).toBe(12.5)
+    expect(parseCloseRouterBalance({ balance: 3 })).toBe(3)
+    expect(parseCloseRouterBalance({ data: {} })).toBeUndefined()
+    expect(parseCloseRouterBalance(null)).toBeUndefined()
+  })
+
+  it('derives the OpenRouter balance from credits minus usage, both required', () => {
+    expect(parseOpenRouterCredits({ data: { total_credits: 275, total_usage: 273.64 } })).toBeCloseTo(1.36, 6)
+    expect(parseOpenRouterCredits({ data: { total_credits: 275 } })).toBeUndefined()
+  })
+
+  it('reads the OpenRouter key limit and treats null as unknown', () => {
+    expect(parseOpenRouterKeyLimit({ data: { limit_remaining: 4.5 } })).toBe(4.5)
+    expect(parseOpenRouterKeyLimit({ data: { limit_remaining: null } })).toBeUndefined()
+  })
+
+  it('reads the 7api balance', () => {
+    expect(parseSevenApiBalance({ object: 'balance', currency: 'USD', balance_usd: 0.3369 })).toBe(0.3369)
+    expect(parseSevenApiBalance({ object: 'balance' })).toBeUndefined()
+  })
+
+  it('accepts numeric strings and rejects everything else', () => {
+    expect(toFiniteNumber(' 2.5 ')).toBe(2.5)
+    expect(toFiniteNumber('')).toBeUndefined()
+    expect(toFiniteNumber('abc')).toBeUndefined()
+    expect(toFiniteNumber(Number.NaN)).toBeUndefined()
+    expect(toFiniteNumber(true)).toBeUndefined()
+  })
+})
+
+describe('price lists', () => {
+  it('maps 7api per-million prices with their own cache-read price and skips incomplete rows', () => {
+    const prices = parseSevenApiPrices({ data: [
+      { id: 'gpt-6-astra', pricing: { price_usd_per_mtok: 0.45, cache_read_usd_per_mtok: 0.04 } },
+      { id: 'broken', pricing: { price_usd_per_mtok: 0.45 } },
+      { pricing: { price_usd_per_mtok: 1, cache_read_usd_per_mtok: 1 } },
+    ] })
+    expect(prices.get('gpt-6-astra')).toEqual({ input: 0.45, output: 0.45, cacheWrite: 0.45, cacheRead: 0.04 })
+    expect(prices.size).toBe(1)
+  })
+
+  it('converts OpenRouter per-token strings to per-million and skips variable pricing', () => {
+    const prices = parseOpenRouterPrices({ data: [
+      { id: 'moonshotai/kimi-k3.1-pro', pricing: { prompt: '0.000002', completion: '0.00001', input_cache_read: '0.0000002' } },
+      { id: 'openrouter/auto', pricing: { prompt: '-1', completion: '-1' } },
+    ] })
+    const kimi = prices.get('moonshotai/kimi-k3.1-pro')
+    expect(kimi?.input).toBeCloseTo(2, 9)
+    expect(kimi?.output).toBeCloseTo(10, 9)
+    expect(kimi?.cacheRead).toBeCloseTo(0.2, 9)
+    expect(kimi?.cacheWrite).toBeCloseTo(2, 9)
+    expect(prices.has('openrouter/auto')).toBe(false)
+  })
+
+  it('prices every bucket per million tokens', () => {
+    const usd = costOfBuckets(
+      {
+        inputTokens: 1_000_000, outputTokens: 500_000, cacheReadTokens: 250_000, cacheWriteTokens: 0,
+        reportedUsd: 0, uncostedSteps: 1, steps: 1,
+      },
+      { input: 2, output: 10, cacheRead: 0.2, cacheWrite: 2 },
+    )
+    expect(usd).toBeCloseTo(2 + 5 + 0.05, 9)
+  })
+})
+
+describe('muse usage', () => {
+  const sample = {
+    identity: { build: '39490bd0', client_id: 'tbh:tui', contributor: true, muse_version: '1.4.13-R6996.1' },
+    observed_at: '2026-10-27T13:55:14Z',
+    requests: 7,
+    subscription: {
+      tier: 'x',
+      weekly: { resets_at: 1793577600, used_percent: 1 },
+      window: { resets_at: 1793124239, used_percent: 3, window_duration_mins: 300 },
+    },
+    tokens: { cached: 89296, input: 157438, output: 2780, reasoning: 1169 },
+  }
+
+  it('normalizes the forwarder reply', () => {
+    expect(parseMuseUsage(sample)).toEqual({
+      weekly: { usedRatio: 0.01, resetAt: '2026-11-02T00:00:00.000Z' },
+      window: { usedRatio: 0.03, resetAt: '2026-10-27T18:03:59.000Z' },
+      windowLabel: '5h window',
+      version: '1.4.13-R6996.1',
+      tokens: { input: 157438, output: 2780, cached: 89296, reasoning: 1169 },
+      requests: 7,
+    })
+  })
+
+  it('clamps percentages and requires both windows', () => {
+    const usage = parseMuseUsage({ subscription: { weekly: { used_percent: '250' }, window: { used_percent: -4 } } })
+    expect(usage?.weekly.usedRatio).toBe(1)
+    expect(usage?.window.usedRatio).toBe(0)
+    expect(usage?.windowLabel).toBe('Window')
+    expect(parseMuseUsage({ subscription: { weekly: { used_percent: 1 } } })).toBeUndefined()
+  })
+
+  it('labels windows and derives the usage URL from the host root', () => {
+    expect(windowLabel(300)).toBe('5h window')
+    expect(windowLabel(60)).toBe('1h window')
+    expect(windowLabel(45)).toBe('45m window')
+    expect(windowLabel(90)).toBe('1h 30m window')
+    expect(windowLabel(undefined)).toBe('Window')
+    expect(museUsageUrl('https://muse.example.test:8788/v1')).toBe('https://muse.example.test:8788/usage')
+    expect(museUsageUrl('http://127.0.0.1:8788/v1/chat')).toBe('http://127.0.0.1:8788/usage')
+  })
+})
