diff --git a/packages/client/ui-provider-billing/src/client/BillingPill.tsx b/packages/client/ui-provider-billing/src/client/BillingPill.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..023b053500edece51587bf8627677b21ade9dac6
--- /dev/null
+++ b/packages/client/ui-provider-billing/src/client/BillingPill.tsx
@@ -0,0 +1,73 @@
+/**
+ * The billing pill before the model picker: the active provider's balance
+ * (or the muse subscription's usage) and the session's cost, subagents
+ * included. Reads the Host's billing frame and the session's model selection;
+ * renders nothing while neither figure is known.
+ */
+import { memo } from 'react'
+import type { UseProjection } from '@deepseek-ai/dsh-api-session-controller/client'
+import type { ObservableSnapshot } from '@deepseek-ai/dsh-client-store'
+import type { ModelDirectoryState } from '@deepseek-ai/dsh-client-ui-model-selection/client'
+import type { InjectFace, PropsLocale } from '@deepseek-ai/dsh-client-ui-slots'
+import type { BillingFrame } from '@deepseek-ai/dsh-provider-billing/types'
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+import css from './BillingPill.module.css'
+
+/**
+ * The registrant's inject face: the Host frame and the session's model
+ * directory (whose `current` is the picker's selection, falling back to the
+ * catalog default before the session logged any selection or request).
+ */
+export interface BillingInjected {
+  hooks: {
+    billing: ObservableSnapshot<BillingFrame | undefined>
+    directory: ObservableSnapshot<ModelDirectoryState>
+  }
+}
+
+type BillingPillProps = InjectFace<BillingInjected> & PropsLocale<'provider-billing'> & {
+  sessionId: SessionId
+  useProjection: UseProjection
+}
+
+const percent = (ratio: number): string => String(Math.round(ratio * 100))
+
+/**
+ * Render the balance and session-cost readings for the route the session uses.
+ * @param props - the billing frame hook, the session's projections, and the pill dictionary.
+ * @returns the pill, or nothing while no figure applies.
+ */
+export const BillingPill = memo(function BillingPill({ sessionId, useProjection, useBilling, useDirectory, t }: BillingPillProps) {
+  const frame = useBilling(value => value)
+  const projected = useProjection('modelSelection', value => value?.next?.provider ?? value?.lastUsed?.provider ?? null)
+  const shown = useDirectory(value => value.current?.provider ?? null)
+  const route = projected ?? shown
+  if (frame === undefined || route === null) return null
+  const billing = frame.routes[route]
+  const cost = frame.sessionCosts[sessionId]
+  const parts: string[] = []
+  const titles: string[] = []
+  if (billing?.kind === 'muse' && billing.muse !== undefined) {
+    const { weekly, window, windowLabel, version } = billing.muse
+    parts.push(t('muse', {
+      weekly: percent(weekly.usedRatio),
+      label: windowLabel.replace(/ window$/, ''),
+      window: percent(window.usedRatio),
+    }))
+    titles.push(t('title.muse', { version: version ?? '' }).trim())
+  } else if (billing?.balanceUsd !== undefined) {
+    parts.push(t('balance', { label: billing.displayName, usd: billing.balanceUsd.toFixed(2) }))
+    titles.push(t('title.balance', { label: billing.displayName }))
+  }
+  if (cost !== undefined && cost.complete && cost.steps > 0) {
+    parts.push(t('session', { usd: cost.usd.toFixed(4) }))
+    titles.push(t('title.session', { sessions: String(cost.sessions) }))
+  }
+  if (parts.length === 0) return null
+  const separator = t('separator')
+  return (
+    <span className={css.pill} data-composer-billing title={titles.join(separator)}>
+      {parts.join(separator)}
+    </span>
+  )
+})
